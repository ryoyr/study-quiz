{
  "name": "study-quiz",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "verify:structure": "node scripts/verify-project.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/e2e-accessibility.mjs",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "check": "npm run verify:structure && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-fsrs": "5.4.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=20.19"
  }
}
